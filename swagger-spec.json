          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Количество записей на странице (максимум 100)",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "example": 20,
              "type": "number"
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Поисковый запрос (по email, имени или телефону)",
            "schema": {
              "example": "иван",
              "type": "string"
