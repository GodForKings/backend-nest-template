PORT=5001
NODE_ENV=development

POSTGRES_USER=template_user
POSTGRES_PASSWORD=template_pass
POSTGRES_DB=template_db
POSTGRES_PORT=5437
POSTGRES_URI=postgresql://template_user:template_pass@localhost:5437/template_db?schema=public

JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:3044
CORS_ORIGINS=http://localhost:3044,http://localhost:3000
COOKIE_DOMAIN=localhost

RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=App <onboarding@resend.dev>

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# IndexNow (Яндекс, Bing)
INDEXNOW_HOST=example.com
INDEXNOW_KEY=your_indexnow_api_key_or_32_hex_chars
INDEXNOW_KEY_LOCATION=https://example.com/your_indexnow_api_key.txt
INDEXNOW_FORCE_ENABLED=false

# LLM (OpenRouter / Cloudflare AI Gateway / OpenAI)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Проксирование запросов к LLM через туннель Xray / HTTP прокси (например, http://172.17.0.1:10809 в Docker или http://127.0.0.1:10809 локально)
LLM_PROXY_URL=http://172.17.0.1:10809
LLM_CF_TOKEN=

